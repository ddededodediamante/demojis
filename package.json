{
  "name": "demojis",
  "version": "1.1.0",
  "description": "A colorful bitmap emoji pack made to pop.",
  "keywords": [
    "emoji",
    "free",
    "cdn"
  ],
  "license": "CC0-1.0",
  "author": "ddededodediamante",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:data": "node scripts/build.js",
    "build:code": "tsup src/index.js --format esm,cjs",
    "build": "npm run build:data && npm run build:code",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
